# JVN Title Screen Theme Configuration
# Place this file at game/scripts/menu.theme

# ===========================================
# TITLE SCREEN ASSETS
# ===========================================

# Background image (classpath or absolute path)
# backgroundImage=game/images/title_bg.png

# Logo/title image (replaces text title)
# logoImage=game/images/logo.png
# logoX=0.5
# logoY=0.15
# logoScale=1.0
# logoShadow=true

# Background music (loops)
# bgm=game/audio/title_bgm.ogg
# bgmVolume=0.7

# ===========================================
# COLORS (hex #RRGGBB or rgb(r,g,b))
# ===========================================

backgroundColor=#0A0C12
titleColor=#FFFFFF
itemColor=#CCCCCC
itemSelectedColor=#FFD700
hintColor=rgba(200,200,200,0.8)
accentColor=#FFD700

# ===========================================
# FONTS
# ===========================================

titleFontFamily=Arial
titleFontWeight=BOLD
titleFontSize=32

itemFontFamily=Arial
itemFontWeight=NORMAL
itemFontSize=20

hintFontFamily=Arial
hintFontWeight=NORMAL
hintFontSize=14

# ===========================================
# LAYOUT
# ===========================================

# titleY: if <= 1 it's a fraction of screen height, else pixels
titleY=60

# listYStart: fraction of screen height where menu items start
listYStart=0.35

# lineHeight: pixels between menu items
lineHeight=40

# Item prefixes
itemPrefix=  
itemSelectedPrefix=> 

# ===========================================
# CUSTOM LABELS (leave empty to use localization)
# ===========================================

# titleText=My Visual Novel
# label.new=New Game
# label.load=Continue
# label.settings=Options
# label.quit=Exit

# Hints at bottom of main menu
# hintsText=Enter: Select    Esc: Quit
