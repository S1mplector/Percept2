java_home_is_usable() {
  local home="$1"
  local version_line version major
  [[ -n "$home" && -x "$home/bin/java" && -x "$home/bin/javac" ]] || return 1
  version_line="$("$home/bin/java" -version 2>&1 | sed -n '1p')" || return 1
  if [[ "$version_line" =~ \"([^\"]+)\" ]]; then
    version="${BASH_REMATCH[1]}"
  elif [[ "$version_line" =~ ([0-9]+)(\.[0-9]+)* ]]; then
    version="${BASH_REMATCH[1]}"
  else
    return 1
  fi
  [[ "$version" == 1.* ]] && version="${version#1.}"
  major="${version%%.*}"
  [[ "$major" =~ ^[0-9]+$ ]] && (( major >= 21 ))
}

java_command_is_usable() {
  local java_path candidate
  command -v java >/dev/null 2>&1 || return 1
  command -v javac >/dev/null 2>&1 || return 1
  java_path="$(command -v java)"
  candidate="$(cd -- "$(dirname -- "$java_path")/.." >/dev/null 2>&1 && pwd || true)"
  java_home_is_usable "$candidate"
}

resolve_java_environment() {
  local candidate java_path

  if java_home_is_usable "${JAVA_HOME:-}"; then
    export PATH="$JAVA_HOME/bin:$PATH"
    return 0
  fi

  if java_command_is_usable; then
    java_path="$(command -v java)"
    candidate="$(cd -- "$(dirname -- "$java_path")/.." >/dev/null 2>&1 && pwd || true)"
    if java_home_is_usable "$candidate"; then
      export JAVA_HOME="$candidate"
    fi
    return 0
  fi

  if [[ "$(uname -s 2>/dev/null || true)" == "Darwin" && -x /usr/libexec/java_home ]]; then
    candidate="$(/usr/libexec/java_home -v 21 2>/dev/null || true)"
    if java_home_is_usable "$candidate"; then
      export JAVA_HOME="$candidate"
      export PATH="$JAVA_HOME/bin:$PATH"
      return 0
    fi
  fi

  for candidate in \
    /opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home \
    /usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home; do
    if java_home_is_usable "$candidate"; then
      export JAVA_HOME="$candidate"
      export PATH="$JAVA_HOME/bin:$PATH"
      return 0
    fi
  done

  return 1
}

show_java_install_hint() {
  if [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]]; then
    printf '  Install JDK 21 with Homebrew:\n'
    printf '    brew install openjdk@21\n'
    printf '    sudo ln -sfn "$(brew --prefix openjdk@21)/libexec/openjdk.jdk" /Library/Java/JavaVirtualMachines/openjdk-21.jdk\n'
    printf '  Or set it for this shell:\n'
    printf '    export JAVA_HOME="$(brew --prefix openjdk@21)/libexec/openjdk.jdk/Contents/Home"\n'
    printf '    export PATH="$JAVA_HOME/bin:$PATH"\n'
  else
    printf '  Install JDK 21, then set JAVA_HOME to its installation directory and add $JAVA_HOME/bin to PATH.\n'
  fi
}

require_java_environment() {
  if resolve_java_environment; then
    return 0
  fi
  printf '%s\n' "$(paint "${style_bold}${tone_error}" "[FAIL]") A working JDK 21+ was not found."
  printf '  The java command may exist but still be a platform placeholder; JVN verifies that java and javac can run.\n'
  show_java_install_hint
  exit 1
}

doctor_check() {
  local status="$1"
  local label="$2"
  local detail="$3"
  printf '  %-6s %-18s %s\n' "$status" "$label" "$detail"
}

run_doctor() {
  local failures=0 warnings=0 java_major java_line gradle_version module_count cache_dir

  printf '%s\n' "$(paint "${style_bold}${tone_brand}" "JVN doctor")"
  printf '  Workspace: %s\n\n' "$SCRIPT_DIR"

  if resolve_java_environment; then
    java_major="$(java_major_version 2>/dev/null || true)"
    java_line="$(java -version 2>&1 | sed -n '1p')"
    if [[ "$java_major" =~ ^[0-9]+$ ]] && (( java_major >= 21 )); then
      doctor_check "[OK]" "Java runtime" "$java_line"
    else
      doctor_check "[FAIL]" "Java runtime" "Java 21+ required; found ${java_line:-unknown runtime}"
      failures=$(( failures + 1 ))
    fi
    doctor_check "[OK]" "Java compiler" "$(javac -version 2>&1 | sed -n '1p')"
    doctor_check "[OK]" "JAVA_HOME" "$JAVA_HOME"
  else
    doctor_check "[FAIL]" "Java runtime" "No working JDK 21+ found"
    doctor_check "[FAIL]" "Java compiler" "javac is unavailable"
    doctor_check "[WARN]" "JAVA_HOME" "${JAVA_HOME:-not set}"
    failures=$(( failures + 2 ))
    warnings=$(( warnings + 1 ))
  fi

  if [[ -x "$GRADLEW_PATH" ]]; then
    gradle_version="$(gradle_wrapper_version 2>/dev/null || true)"
    doctor_check "[OK]" "Gradle wrapper" "executable${gradle_version:+; version $gradle_version}"
  else
    doctor_check "[FAIL]" "Gradle wrapper" "missing or not executable: $GRADLEW_PATH"
    failures=$(( failures + 1 ))
  fi

  module_count="$(find "$SCRIPT_DIR/modules" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "$module_count" =~ ^[0-9]+$ ]] && (( module_count > 0 )); then
    doctor_check "[OK]" "Modules" "$module_count module directories found"
  else
    doctor_check "[FAIL]" "Modules" "no module directories found"
    failures=$(( failures + 1 ))
  fi

  cache_dir="${GRADLE_USER_HOME:-$HOME/.gradle}"
  if [[ -d "$cache_dir" && -w "$cache_dir" ]]; then
    doctor_check "[OK]" "Gradle cache" "$cache_dir"
  elif [[ ! -e "$cache_dir" && -w "$(dirname -- "$cache_dir")" ]]; then
    doctor_check "[OK]" "Gradle cache" "$cache_dir (will be created)"
  else
    doctor_check "[WARN]" "Gradle cache" "$cache_dir is not writable"
    warnings=$(( warnings + 1 ))
  fi

  if [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]]; then
    if [[ -x /usr/libexec/java_home ]] && /usr/libexec/java_home -v 21 >/dev/null 2>&1; then
      doctor_check "[OK]" "macOS registry" "JDK 21 is registered"
    else
      doctor_check "[WARN]" "macOS registry" "JDK 21 is usable in shell but not registered for GUI launchers"
      warnings=$(( warnings + 1 ))
    fi
  fi

  if IFS= read -r -t 0.1 < /dev/null 2>/dev/null; then
    doctor_check "[OK]" "Bash timeout" "fractional read timeouts supported"
  else
    doctor_check "[OK]" "Bash timeout" "whole-second compatibility mode active (Bash $BASH_VERSION)"
  fi

  printf '\n'
  if (( failures > 0 )); then
    printf '%s\n' "$(paint "${style_bold}${tone_error}" "[FAIL]") Doctor found $failures blocking issue(s) and $warnings warning(s)."
    show_java_install_hint
    return 1
  fi
  if (( warnings > 0 )); then
    printf '%s\n' "$(paint "${style_bold}${tone_warn}" "[WARN]") Doctor passed with $warnings warning(s)."
  else
    printf '%s\n' "$(paint "${style_bold}${tone_success}" "[OK]") Development environment is ready."
  fi
}

java_major_version() {
  local version_line version
  version_line="$(java -version 2>&1 | sed -n '1p')" || return 1
  if [[ "$version_line" =~ \"([^\"]+)\" ]]; then
    version="${BASH_REMATCH[1]}"
  elif [[ "$version_line" =~ ([0-9]+)(\.[0-9]+)* ]]; then
    version="${BASH_REMATCH[1]}"
  else
    return 1
  fi

  if [[ "$version" == 1.* ]]; then
    version="${version#1.}"
  fi
  printf '%s\n' "${version%%.*}"
}

gradle_wrapper_version() {
  local properties_path="$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.properties"
  [[ -f "$properties_path" ]] || return 1
  sed -nE 's#^distributionUrl=.*gradle-([0-9]+(\.[0-9]+){1,2})-(bin|all)\.zip.*$#\1#p' "$properties_path" | head -n 1
}

gradle_supports_java_runtime() {
  local gradle_version="$1"
  local java_major="$2"
  local gradle_major gradle_minor min_gradle_major min_gradle_minor

  gradle_major="${gradle_version%%.*}"
  gradle_minor="${gradle_version#*.}"
  gradle_minor="${gradle_minor%%.*}"

  if (( java_major >= 26 )); then
    min_gradle_major=9
    min_gradle_minor=4
  elif (( java_major >= 25 )); then
    min_gradle_major=9
    min_gradle_minor=1
  else
    return 0
  fi

  if (( gradle_major < min_gradle_major )); then
    return 1
  fi
  if (( gradle_major == min_gradle_major && gradle_minor < min_gradle_minor )); then
    return 1
  fi

  return 0
}

minimum_gradle_for_java_runtime() {
  local java_major="$1"
  if (( java_major >= 26 )); then
    printf '9.4.0'
  elif (( java_major >= 25 )); then
    printf '9.1.0'
  else
    printf '%s' 'current'
  fi
}

check_java_gradle_compatibility() {
  local java_major gradle_version java_runtime min_gradle
  java_major="$(java_major_version)" || return 0
  gradle_version="$(gradle_wrapper_version)" || return 0
  gradle_supports_java_runtime "$gradle_version" "$java_major" && return 0

  min_gradle="$(minimum_gradle_for_java_runtime "$java_major")"
  java_runtime="$(java -version 2>&1 | sed -n '1p')"
  printf '%s\n' "$(paint "${style_bold}${tone_error}" "[FAIL]") Gradle $gradle_version cannot run on Java $java_major."
  printf '  Detected: %s\n' "${java_runtime:-Java runtime unknown}"
  printf '  This workspace compiles with the Java 21 toolchain, but Gradle must start on a compatible launcher JDK first.\n'
  printf '  Use JDK 21 for this shell, then retry:\n'
  printf '    export JAVA_HOME=$(/usr/libexec/java_home -v 21)\n'
  printf '    ./gradlew --stop\n'
  printf '    ./jvnw editor\n'
  printf '  Or upgrade the Gradle wrapper to %s+ before running on Java %s.\n' "$min_gradle" "$java_major"
  exit 1
}

declare -a input_args=()
if [[ $# -gt 0 ]]; then
  for arg in "$@"; do
    if [[ "$arg" == "--raw" ]]; then
      raw_mode=1
    else
      input_args+=("$arg")
    fi
  done
fi

if [[ "$raw_mode" != "1" ]]; then
  if [[ ${#input_args[@]} -eq 0 ]]; then
    show_help
    exit 0
  fi

  if [[ ${#input_args[@]} -eq 1 ]]; then
    case "${input_args[0]}" in
      help|-h|--help)
        show_help
        exit 0
        ;;
    esac
  fi

  if [[ "${input_args[0]}" == "doctor" ]]; then
    run_doctor
    exit $?
  fi
fi

require_java_environment
check_java_gradle_compatibility

if [[ "$raw_mode" == "1" ]]; then
  if [[ ${#input_args[@]} -gt 0 ]]; then
    exec "$GRADLEW_PATH" "${input_args[@]}"
  fi
  exec "$GRADLEW_PATH"
fi

declare -a forwarded_args=()
alias_label=""
first_non_option_seen=0
prefer_configuration_cache=0

for arg in "${input_args[@]}"; do
  if [[ "$first_non_option_seen" -eq 0 && "$arg" != -* ]]; then
    first_non_option_seen=1
    case "$arg" in
      help|-h|--help)
        show_help
        exit 0
        ;;
      launcher)
        alias_label="launcher"
        forwarded_args+=(":editor:runLauncher")
        prefer_configuration_cache=1
        ;;
      editor)
        alias_label="editor"
        forwarded_args+=(":editor:run")
        prefer_configuration_cache=1
        ;;
      runtime|run|game)
        alias_label="runtime"
        forwarded_args+=(":runtime:run")
        prefer_configuration_cache=1
        ;;
      compile|compile-all|compileAll)
        alias_label="compile"
        forwarded_args+=("compileAll")
        prefer_configuration_cache=1
        ;;
      quick|quick-check|quickCheck)
        alias_label="quick"
        forwarded_args+=("quickCheck")
        prefer_configuration_cache=1
        ;;
      build)
        alias_label="build"
        forwarded_args+=("build")
        prefer_configuration_cache=1
        ;;
      ci)
        alias_label="ci"
        forwarded_args+=("ci")
        prefer_configuration_cache=1
        ;;
      test)
        alias_label="test"
        forwarded_args+=("test")
        prefer_configuration_cache=1
        ;;
      check)
        alias_label="check"
        forwarded_args+=("check")
        prefer_configuration_cache=1
        ;;
      clean)
        alias_label="clean"
        forwarded_args+=("clean")
        prefer_configuration_cache=1
        ;;
      dist)
        alias_label="dist"
        forwarded_args+=("assembleJvnGamePortableCurrent")
        ;;
      dist-all|distAll|portable-all|portableAll)
        alias_label="dist-all"
        forwarded_args+=("assembleJvnGamePortable")
        ;;
      dist-runtime|distRuntime|portable-runtime|portableRuntime|bundled-runtime|bundledRuntime)
        alias_label="dist-runtime"
        forwarded_args+=("assembleJvnGameBundledRuntimeCurrent")
        ;;
      dist-runtime-all|distRuntimeAll|bundled-runtime-all|bundledRuntimeAll|portable-runtime-all|portableRuntimeAll)
        alias_label="dist-runtime-all"
        forwarded_args+=("assembleJvnGameBundledRuntime")
        ;;
      dist-preflight|distPreflight|preflight|build-plan|buildPlan)
        alias_label="dist-preflight"
        forwarded_args+=("preflightJvnGameBuild")
        ;;
      dist-clean|distClean|clean-dist|cleanDist)
        alias_label="dist-clean"
        forwarded_args+=("cleanJvnGameDistributions")
        ;;
      runtime-cache|runtimeCache)
        alias_label="runtime-cache"
        forwarded_args+=("printJvnBundledRuntimeCache")
        ;;
      runtime-cache-clear|runtimeCacheClear)
        alias_label="runtime-cache-clear"
        forwarded_args+=("clearJvnBundledRuntimeCache")
        ;;
      native|package-native|packageNative)
        alias_label="native"
        forwarded_args+=("packageJvnGameNativeCurrent")
        ;;
      release-native|releaseNative)
        alias_label="release-native"
        forwarded_args+=("releaseJvnGameNativeCurrent")
        ;;
      build-info|buildInfo)
        alias_label="build-info"
        forwarded_args+=("printJvnBuildEnvironment")
        ;;
      jar)
        alias_label="jar"
        forwarded_args+=(":runtime:jar")
        prefer_configuration_cache=1
        ;;
      gradle)
        alias_label="gradle"
        ;;
      *)
        forwarded_args+=("$arg")
        ;;
    esac
  else
    forwarded_args+=("$arg")
  fi
done

console_specified=0
configuration_cache_specified=0
max_workers_specified=0
declare -a task_args=()
if [[ ${#forwarded_args[@]} -gt 0 ]]; then
  for arg in "${forwarded_args[@]}"; do
    case "$arg" in
      --console|--console=*)
        console_specified=1
        ;;
      --configuration-cache|--configuration-cache=*|--no-configuration-cache|-Dorg.gradle.configuration-cache=*|-Dorg.gradle.configuration-cache)
        configuration_cache_specified=1
        ;;
      --max-workers|--max-workers=*)
        max_workers_specified=1
        ;;
    esac
    if [[ "$arg" != -* ]]; then
      task_args+=("$arg")
    fi
  done
fi

cpu_count() {
  if command -v getconf >/dev/null 2>&1; then
    getconf _NPROCESSORS_ONLN 2>/dev/null && return
  fi
  if command -v sysctl >/dev/null 2>&1; then
    sysctl -n hw.ncpu 2>/dev/null && return
  fi
  printf '2\n'
}

launch_workers() {
  local cpus
  cpus="$(cpu_count)"
  case "$cpus" in
    ''|*[!0-9]*) cpus=2 ;;
  esac
  if (( cpus <= 2 )); then
    printf '1\n'
  else
    printf '2\n'
  fi
}

declare -a gradle_cmd=("$GRADLEW_PATH")
if [[ "$console_specified" -eq 0 ]]; then
  gradle_cmd+=("--console=plain")
fi
if [[ "$prefer_configuration_cache" -eq 1 && "$configuration_cache_specified" -eq 0 ]]; then
  gradle_cmd+=("--configuration-cache")
fi
if [[ "$max_workers_specified" -eq 0 ]]; then
  case "$alias_label" in
    launcher|editor|runtime)
      gradle_cmd+=("--max-workers=$(launch_workers)")
      ;;
  esac
fi
if [[ ${#forwarded_args[@]} -gt 0 ]]; then
  gradle_cmd+=("${forwarded_args[@]}")
fi

spinner_frames=('|' '/' '-' '\')
spinner_index=0
supports_fractional_timeout=1
if ! IFS= read -r -t 0.1 < /dev/null 2>/dev/null; then
  supports_fractional_timeout=0
  spinner_tick_seconds="1"
else
  spinner_tick_seconds="0.10"
fi
spinner_tick_marker="__JVNW_SPINNER_TICK__"
status_text="Preparing..."
done_message="Command completed."
compile_started=0
compile_ok_announced=0
launch_announced=0
tests_announced=0
live_failure_output_seen=0
launch_live_announced=0
suppress_status_render=0
command_label=""
resolved_target=""
wrapper_mode="Gradle task"

case "$alias_label" in
  launcher|editor|runtime|compile|quick|build|ci|test|check|clean|dist|dist-all|dist-runtime|dist-runtime-all|dist-preflight|dist-clean|runtime-cache|runtime-cache-clear|native|release-native|build-info|jar)
    command_label="$alias_label"
    ;;
esac

case "$alias_label" in
  launcher|editor|runtime|compile|quick|build|ci|test|check|clean|dist|dist-all|dist-runtime|dist-runtime-all|dist-preflight|dist-clean|runtime-cache|runtime-cache-clear|native|release-native|build-info|jar)
    wrapper_mode="JVN shortcut"
    ;;
  gradle)
    wrapper_mode="Gradle passthrough"
    ;;
esac

case "$alias_label" in
  compile)
    done_message="Compilation OK."
    ;;
  quick)
    done_message="Quick verification OK."
    ;;
  build)
    done_message="Workspace build OK."
    ;;
  ci)
    done_message="CI verification OK."
    ;;
  test)
    done_message="Test suite OK."
    ;;
  check)
    done_message="Checks completed."
    ;;
  clean)
    done_message="Workspace cleaned."
    ;;
  dist)
    done_message="Portable distribution ready."
    ;;
  dist-all)
    done_message="Portable distributions ready."
    ;;
  dist-runtime)
    done_message="Desktop bundle ready."
    ;;
  dist-runtime-all)
    done_message="Desktop bundles ready."
    ;;
  dist-preflight)
    done_message="Game build preflight OK."
    ;;
  dist-clean)
    done_message="Game build artifacts cleaned."
    ;;
  build-info)
    done_message="Build environment printed."
    ;;
  jar)
    done_message="Runtime jar ready."
    ;;
  launcher|editor|runtime)
    done_message="Process exited cleanly."
    ;;
esac

temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/jvnw.XXXXXX")"
fifo_path="$temp_dir/gradle.pipe"
output_log="$temp_dir/gradle.log"
touch "$output_log"
mkfifo "$fifo_path"

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

clear_status() {
  if [[ "$supports_spinner" -eq 1 ]]; then
    printf '\r\033[K'
  fi
}

render_status() {
  if [[ "$supports_spinner" -eq 1 && -n "$status_text" ]]; then
    printf '\r%s %s' "${spinner_frames[$spinner_index]}" "$status_text"
    spinner_index=$(( (spinner_index + 1) % ${#spinner_frames[@]} ))
  fi
}

emit_line() {
  clear_status
  printf '%s\n' "$1"
}

emit_section() {
  emit_line "$(paint "${style_bold}${tone_info}" "$1")"
}

emit_detail() {
  emit_line "  $(paint "${style_bold}${tone_info}" "$1") $(paint "${style_bold}" "$2")"
}

emit_info() {
  emit_line "$(paint "${style_bold}${tone_info}" "[INFO]") $1"
}

emit_ok() {
  emit_line "$(paint "${style_bold}${tone_success}" "[OK]") $1"
}

emit_warn() {
  emit_line "$(paint "${style_bold}${tone_warn}" "[WARN]") $1"
}

emit_error() {
  emit_line "$(paint "${style_bold}${tone_error}" "[FAIL]") $1"
}

emit_hint() {
  emit_line "$(paint "${style_dim}${tone_hint}" "$1")"
}

emit_raw() {
  local line="$1"
  case "$line" in
    FAILURE:*|*"Execution failed for task"*|*"What went wrong:"*|*"Caused by:"*|*"BUILD FAILED"*)
      emit_line "$(paint "$tone_error" "$line")"
      ;;
    WARNING:*|*WARN*)
      emit_line "$(paint "$tone_warn" "$line")"
      ;;
    *)
      emit_line "$line"
      ;;
  esac
}

is_real_error_line() {
  local line="$1"
  [[ "$line" == *"Execution failed for task"* ]] && return 0
  [[ "$line" == *"BUILD FAILED"* ]] && return 0
  [[ "$line" == FAILURE:* ]] && return 0
  [[ "$line" == *" What went wrong:"* ]] && return 0
  [[ "$line" == *"* What went wrong:"* ]] && return 0
  [[ "$line" == *"A problem was found with the configuration of task"* ]] && return 0
  [[ "$line" == *"problems were found with the configuration of task"* ]] && return 0
  [[ "$line" == *"Reason:"* ]] && return 0
  [[ "$line" == *"Possible solution:"* ]] && return 0
  [[ "$line" == *"conflicting normalization annotations"* ]] && return 0
  [[ "$line" == *"configuration cache problems"* ]] && return 0
  [[ "$line" == *"Caused by:"* ]] && return 0
  [[ "$line" == *"Exception"* ]] && return 0
  [[ "$line" == *": error:"* ]] && return 0
  [[ "$line" == *" error C"* ]] && return 0
  [[ "$line" == *"fatal error:"* ]] && return 0
  return 1
}

output_log_contains() {
  local pattern="$1"
  [[ -f "$output_log" ]] || return 1
  grep -qiE "$pattern" "$output_log"
}

javafx_gtk_failure_seen() {
  output_log_contains 'unable to load glass gtk library|glass gtk|glassgtk|libgtk|gtk.*javafx|javafx.*gtk'
}

linux_package_manager_hint() {
  if command -v dnf >/dev/null 2>&1; then
    printf 'sudo dnf install gtk3 libXtst libXxf86vm alsa-lib libXrender libXrandr libXinerama libXi'
  elif command -v apt >/dev/null 2>&1; then
    printf 'sudo apt install libgtk-3-0 libxtst6 libxxf86vm1 libasound2 libxrender1 libxrandr2 libxinerama1 libxi6'
  elif command -v pacman >/dev/null 2>&1; then
    printf 'sudo pacman -S gtk3 libxtst libxxf86vm alsa-lib libxrender libxrandr libxinerama libxi'
  elif command -v zypper >/dev/null 2>&1; then
    printf 'sudo zypper install gtk3 libXtst6 libXxf86vm1 libasound2 libXrender1 libXrandr2 libXinerama1 libXi6'
  elif command -v apk >/dev/null 2>&1; then
    printf 'sudo apk add gtk+3.0 libxtst libxxf86vm alsa-lib libxrender libxrandr libxinerama libxi'
  else
    printf 'Install GTK 3 plus X11/ALSA runtime libraries in the container: gtk3, libXtst, libXxf86vm, alsa-lib, libXrender, libXrandr, libXinerama, libXi.'
  fi
}

show_environment_failure_hints() {
  if javafx_gtk_failure_seen; then
    emit_section "JavaFX GTK dependency hint"
    if is_containerized_shell; then
      emit_hint "The editor is running inside $(container_name_label); install the JavaFX GTK/X11 native runtime libraries inside that container."
    else
      emit_hint "Install the JavaFX GTK/X11 native runtime libraries in the environment that runs the editor."
    fi
    emit_hint "$(linux_package_manager_hint)"
    emit_hint "Then retry: ./jvnw editor"
  fi
}

should_surface_line() {
  local line="$1"
  if [[ "$debug_mode" == "1" || "$alias_label" == "gradle" ]]; then
    return 0
  fi
  if [[ "$alias_label" == "build-info" ]]; then
    return 0
  fi
  case "$line" in
    "> Task "*)
      ;;
    ">"*)
      return 0
      ;;
    *" FAILED"*)
      return 0
      ;;
  esac
  if is_real_error_line "$line"; then
    return 0
  fi
  return 1
}

show_failure_summary() {
  local elapsed_label="$1"
  if [[ "$debug_mode" == "1" ]]; then
    emit_error "Command failed after ${elapsed_label}."
    return
  fi

  emit_error "Command failed after ${elapsed_label}."
  if [[ "$live_failure_output_seen" -eq 1 ]]; then
    emit_hint "Failure output was already surfaced above."
  else
    emit_section "Relevant output"

    local surfaced=0
    while IFS= read -r line; do
      if should_surface_line "$line"; then
        emit_raw "$line"
        surfaced=1
      fi
    done <"$output_log"

    if [[ "$surfaced" -eq 0 ]]; then
      tail -n 40 "$output_log" | while IFS= read -r line; do
        emit_raw "$line"
      done
    fi
  fi

  emit_hint "Re-run with ./jvnw --raw <same-args> for full Gradle output."
  if [[ "$alias_label" == "editor" ]]; then
    printf '\n'
    emit_section "Automatic environment check"
    run_doctor || true
  fi
}

handle_line() {
  local line="$1"

  case "$line" in
    Starting\ a\ Gradle\ Daemon*|*busy\ and*Daemons\ could\ not\ be\ reused*)
      status_text="Starting Gradle daemon..."
      ;;
    "> Task "*:compileJava*|"> Task "*:compileKotlin*|"> Task "*:compileScala*)
      if [[ "$compile_started" -eq 0 ]]; then
        emit_info "Compiling modules..."
        compile_started=1
      fi
      status_text="Compiling modules..."
      ;;
    "> Task "*:processResources*|"> Task "*:classes*)
      if [[ "$compile_started" -eq 1 ]]; then
        status_text="Finalizing compiled modules..."
      fi
      ;;
    "> Task :"?*":test"*)
      if [[ "$compile_started" -eq 1 && "$compile_ok_announced" -eq 0 ]]; then
        emit_info "Compilation finished."
        compile_ok_announced=1
      fi
      if [[ "$tests_announced" -eq 0 ]]; then
        emit_info "Running tests..."
        tests_announced=1
      fi
      status_text="Running tests..."
      ;;
    "> Task :editor:runLauncher"*|"> Task :editor:run"*|"> Task :runtime:run"*)
      if [[ "$compile_started" -eq 1 && "$compile_ok_announced" -eq 0 ]]; then
        emit_info "Compilation finished."
        compile_ok_announced=1
      fi
      if [[ "$launch_announced" -eq 0 ]]; then
        emit_info "Launching..."
        launch_announced=1
      fi
      suppress_status_render=0
      launch_live_announced=0
      status_text="Launching..."
      ;;
    WARNING:\ A\ restricted\ method\ in\ java.lang.System\ has\ been\ called*|\
    WARNING:\ java.lang.System::*|\
    WARNING:\ Use\ --enable-native-access=*|\
    WARNING:\ Restricted\ methods\ will\ be\ blocked*|\
    WARNING:\ A\ terminally\ deprecated\ method\ in\ sun.misc.Unsafe\ has\ been\ called*|\
    WARNING:\ sun.misc.Unsafe::*|\
    WARNING:\ Please\ consider\ reporting\ this\ to\ the\ maintainers*)
      ;;
    Note:\ Some\ input\ files\ use\ unchecked\ or\ unsafe\ operations.*|\
    Note:\ Recompile\ with\ -Xlint:unchecked\ for\ details.*)
      ;;
    BUILD\ SUCCESSFUL*)
      if [[ "$done_message" == "Command completed." ]]; then
        done_message="Ready."
      fi
      ;;
    "")
      ;;
    *)
      if should_surface_line "$line"; then
        live_failure_output_seen=1
        emit_raw "$line"
      fi
      ;;
  esac
}

if [[ -z "$command_label" && ${#task_args[@]} -gt 0 ]]; then
  command_label="${task_args[*]}"
fi

if [[ ${#task_args[@]} -gt 0 ]]; then
  resolved_target="$(join_by_space "${task_args[@]}")"
fi

if [[ -n "$command_label" ]]; then
  status_text="Preparing ${command_label}..."
fi

if [[ -n "$command_label" || -n "$resolved_target" ]]; then
  if [[ -n "$command_label" ]]; then
    emit_detail "Command" "$command_label"
  fi
  if [[ -n "$resolved_target" ]]; then
    emit_detail "Target " "$resolved_target"
  fi
  emit_detail "Mode   " "$wrapper_mode"
  printf '\n'
fi

start_time_epoch="$(date +%s)"
if [[ "$supports_spinner" -eq 1 ]]; then
  render_status
fi
"${gradle_cmd[@]}" >"$fifo_path" 2>&1 &
gradle_pid=$!

exec 3<"$fifo_path"

while true; do
  if IFS= read -r -t "$spinner_tick_seconds" line <&3; then
    printf '%s\n' "$line" >>"$output_log"
    handle_line "$line"
  else
    if kill -0 "$gradle_pid" 2>/dev/null; then
      if [[ "$launch_announced" -eq 1 && "$launch_live_announced" -eq 0 ]]; then
        clear_status
        case "$command_label" in
          launcher)
            emit_info "Launcher running. Close the launcher window to finish this command."
            ;;
          editor)
            emit_info "Editor running. Close the editor window to finish this command."
            ;;
          runtime|run|game)
            emit_info "Runtime running. Close the runtime window to finish this command."
            ;;
          *)
            emit_info "Application process is running."
            ;;
        esac
        launch_live_announced=1
        suppress_status_render=1
      fi
      if [[ "$suppress_status_render" -eq 0 ]]; then
        render_status
      fi
    else
      break
    fi
  fi
done

if [[ "$supports_fractional_timeout" -eq 1 ]]; then
  while IFS= read -r -t 0.01 line <&3; do
    printf '%s\n' "$line" >>"$output_log"
    handle_line "$line"
  done
else
  while IFS= read -r -t 0 line <&3 2>/dev/null && IFS= read -r line <&3; do
    printf '%s\n' "$line" >>"$output_log"
    handle_line "$line"
  done
fi
exec 3<&-

wait "$gradle_pid"
exit_code=$?
elapsed_seconds=$(( $(date +%s) - start_time_epoch ))
elapsed_label="$(format_duration "$elapsed_seconds")"

clear_status

if [[ "$exit_code" -eq 0 ]]; then
  emit_ok "${done_message} ${elapsed_label}"
else
  show_failure_summary "$elapsed_label"
  show_environment_failure_hints
fi

exit "$exit_code"
