#!/usr/bin/env bash

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
GRADLEW_PATH="$SCRIPT_DIR/gradlew"

if [[ ! -f "$GRADLEW_PATH" ]]; then
  printf 'JVN wrapper error: missing %s\n' "$GRADLEW_PATH" >&2
  exit 1
fi

raw_mode="${JVN_WRAPPER_RAW:-0}"
debug_mode="${JVN_WRAPPER_DEBUG:-0}"
supports_spinner=0
supports_color=0

if [[ -t 1 && "${TERM:-}" != "dumb" && -z "${CI:-}" ]]; then
  supports_spinner=1
fi

if [[ -t 1 && "${TERM:-}" != "dumb" && -z "${NO_COLOR:-}" ]]; then
  supports_color=1
fi

style_reset=""
style_bold=""
style_dim=""
tone_brand=""
tone_info=""
tone_success=""
tone_warn=""
tone_error=""
tone_hint=""

if [[ "$supports_color" -eq 1 ]]; then
  style_reset=$'\033[0m'
  style_bold=$'\033[1m'
  style_dim=$'\033[2m'
  tone_brand=$'\033[38;5;214m'
  tone_info=$'\033[38;5;117m'
  tone_success=$'\033[38;5;78m'
  tone_warn=$'\033[38;5;221m'
  tone_error=$'\033[38;5;203m'
  tone_hint=$'\033[38;5;246m'
fi

paint() {
  local style="$1"
  shift
  if [[ -z "$style" || "$supports_color" -eq 0 ]]; then
    printf '%s' "$*"
  else
    printf '%b%s%b' "$style" "$*" "$style_reset"
  fi
}

join_by_space() {
  if [[ $# -eq 0 ]]; then
    return
  fi
  local first=1
  local item
  for item in "$@"; do
    if [[ "$first" -eq 1 ]]; then
      printf '%s' "$item"
      first=0
    else
      printf ' %s' "$item"
    fi
  done
}

format_duration() {
  local total_seconds="$1"
  local hours=$(( total_seconds / 3600 ))
  local minutes=$(( (total_seconds % 3600) / 60 ))
  local seconds=$(( total_seconds % 60 ))

  if (( hours > 0 )); then
    printf '%dh %dm %ds' "$hours" "$minutes" "$seconds"
  elif (( minutes > 0 )); then
    printf '%dm %ds' "$minutes" "$seconds"
  else
    printf '%ds' "$seconds"
  fi
}

print_help_row() {
  local command="$1"
  local description="$2"
  printf '  %-44s %s\n' "$(paint "${style_bold}${tone_brand}" "$command")" "$description"
}

show_help() {
  printf '%s\n' "$(paint "${style_bold}${tone_brand}" "jvnw")"
  printf '%s\n' "Use ./jvnw for common tasks. Known commands map to Gradle tasks; everything else passes through."
  printf '\n'
  printf '%s\n' "$(paint "${style_bold}${tone_info}" "Common commands")"
  print_help_row "./jvnw launcher" "Run the standalone launcher"
  print_help_row "./jvnw editor" "Run the editor"
  print_help_row "./jvnw runtime" "Run the runtime"
  print_help_row "./jvnw compile" "Compile every module without running tests"
  print_help_row "./jvnw quick" "Compile all modules and run the fast verification slice"
  print_help_row "./jvnw build" "Build the workspace"
  print_help_row "./jvnw ci" "Run the compile/test workflow used by CI"
  print_help_row "./jvnw test" "Run the test suite"
  print_help_row "./jvnw check" "Run verification tasks"
  print_help_row "./jvnw clean" "Remove build outputs"
  print_help_row "./jvnw dist -PjvnGameProject=<dir>" "Create a game zip for this OS/arch"
  print_help_row "./jvnw dist-all -PjvnGameProject=<dir>" "Create game zips for every supported OS/arch"
  print_help_row "./jvnw dist-runtime -PjvnGameProject=<dir>" "Create a self-contained desktop bundle for this OS/arch"
  print_help_row "./jvnw dist-runtime-all -PjvnGameProject=<dir>" "Create self-contained desktop bundles for every supported OS/arch"
  print_help_row "./jvnw dist-preflight -PjvnGameProject=<dir>" "Validate the selected package plan and write a build report"
  print_help_row "./jvnw dist-clean" "Delete packaged game artifacts"
  print_help_row "./jvnw runtime-cache" "Show cached prebuilt desktop runtimes"
  print_help_row "./jvnw runtime-cache-clear" "Clear cached prebuilt desktop runtimes"
  print_help_row "./jvnw native -PjvnGameProject=<dir>" "Create a native package for this host"
  print_help_row "./jvnw release-native -PjvnGameProject=<dir>" "Build native package and run release profile hooks for this host"
  print_help_row "./jvnw build-info" "Print Java, Gradle, JavaFX, and module configuration"
  print_help_row "./jvnw jar" "Build the runtime jar"
  printf '\n'
  printf '%s\n' "$(paint "${style_bold}${tone_info}" "Advanced usage")"
  print_help_row "./jvnw gradle <gradle-args>" "Pass through to Gradle with wrapper status output"
  print_help_row "./jvnw --raw <gradle-args>" "Call ./gradlew directly with full Gradle output"
  print_help_row "./gradlew <gradle-task>" "Optional low-level Gradle entrypoint"
  printf '\n'
  printf '%s\n' "$(paint "${style_bold}${tone_info}" "Examples")"
  print_help_row "./jvnw launcher" "Run the launcher"
  print_help_row "./jvnw runtime --args='--script scripts/story/prologue.vns'" "Run a specific script"
  print_help_row "./jvnw gradle :editor:compileJava" "Target a single Gradle task manually"
}

java_major_version() {
  local version_line version
  version_line="$(java -version 2>&1 | sed -n '1p')" || return 1
  if [[ "$version_line" =~ \"([^\"]+)\" ]]; then
    version="${BASH_REMATCH[1]}"
  elif [[ "$version_line" =~ ([0-9]+)(\.[0-9]+)* ]]; then
    version="${BASH_REMATCH[1]}"
  else
    return 1
  fi

  if [[ "$version" == 1.* ]]; then
    version="${version#1.}"
  fi
  printf '%s\n' "${version%%.*}"
}

gradle_wrapper_version() {
  local properties_path="$SCRIPT_DIR/gradle/wrapper/gradle-wrapper.properties"
  [[ -f "$properties_path" ]] || return 1
  sed -nE 's#^distributionUrl=.*gradle-([0-9]+(\.[0-9]+){1,2})-(bin|all)\.zip.*$#\1#p' "$properties_path" | head -n 1
}

gradle_supports_java_runtime() {
  local gradle_version="$1"
  local java_major="$2"
  local gradle_major gradle_minor min_gradle_major min_gradle_minor

  gradle_major="${gradle_version%%.*}"
  gradle_minor="${gradle_version#*.}"
  gradle_minor="${gradle_minor%%.*}"

  if (( java_major >= 26 )); then
    min_gradle_major=9
    min_gradle_minor=4
  elif (( java_major >= 25 )); then
    min_gradle_major=9
    min_gradle_minor=1
  else
    return 0
  fi

  if (( gradle_major < min_gradle_major )); then
    return 1
  fi
  if (( gradle_major == min_gradle_major && gradle_minor < min_gradle_minor )); then
    return 1
  fi

  return 0
}

minimum_gradle_for_java_runtime() {
  local java_major="$1"
  if (( java_major >= 26 )); then
    printf '9.4.0'
  elif (( java_major >= 25 )); then
    printf '9.1.0'
  else
    printf '%s' 'current'
  fi
}

check_java_gradle_compatibility() {
  local java_major gradle_version java_runtime min_gradle
  java_major="$(java_major_version)" || return 0
  gradle_version="$(gradle_wrapper_version)" || return 0
  gradle_supports_java_runtime "$gradle_version" "$java_major" && return 0

  min_gradle="$(minimum_gradle_for_java_runtime "$java_major")"
  java_runtime="$(java -version 2>&1 | sed -n '1p')"
  printf '%s\n' "$(paint "${style_bold}${tone_error}" "[FAIL]") Gradle $gradle_version cannot run on Java $java_major."
  printf '  Detected: %s\n' "${java_runtime:-Java runtime unknown}"
  printf '  This workspace compiles with the Java 21 toolchain, but Gradle must start on a compatible launcher JDK first.\n'
  printf '  Use JDK 21 for this shell, then retry:\n'
  printf '    export JAVA_HOME=$(/usr/libexec/java_home -v 21)\n'
  printf '    ./gradlew --stop\n'
  printf '    ./jvnw editor\n'
  printf '  Or upgrade the Gradle wrapper to %s+ before running on Java %s.\n' "$min_gradle" "$java_major"
  exit 1
}

declare -a input_args=()
if [[ $# -gt 0 ]]; then
  for arg in "$@"; do
    if [[ "$arg" == "--raw" ]]; then
      raw_mode=1
    else
      input_args+=("$arg")
    fi
  done
fi

if [[ "$raw_mode" != "1" ]]; then
  if [[ ${#input_args[@]} -eq 0 ]]; then
    show_help
    exit 0
  fi

  if [[ ${#input_args[@]} -eq 1 ]]; then
    case "${input_args[0]}" in
      help|-h|--help)
        show_help
        exit 0
        ;;
    esac
  fi
fi

check_java_gradle_compatibility

if [[ "$raw_mode" == "1" ]]; then
  if [[ ${#input_args[@]} -gt 0 ]]; then
    exec "$GRADLEW_PATH" "${input_args[@]}"
  fi
  exec "$GRADLEW_PATH"
fi

declare -a forwarded_args=()
alias_label=""
first_non_option_seen=0
prefer_configuration_cache=0

for arg in "${input_args[@]}"; do
  if [[ "$first_non_option_seen" -eq 0 && "$arg" != -* ]]; then
    first_non_option_seen=1
    case "$arg" in
      help|-h|--help)
        show_help
        exit 0
        ;;
      launcher)
        alias_label="launcher"
        forwarded_args+=(":editor:runLauncher")
        ;;
      editor)
        alias_label="editor"
        forwarded_args+=(":editor:run")
        ;;
      runtime|run|game)
        alias_label="runtime"
        forwarded_args+=(":runtime:run")
        ;;
      compile|compile-all|compileAll)
        alias_label="compile"
        forwarded_args+=("compileAll")
        prefer_configuration_cache=1
        ;;
      quick|quick-check|quickCheck)
        alias_label="quick"
        forwarded_args+=("quickCheck")
        prefer_configuration_cache=1
        ;;
      build)
        alias_label="build"
        forwarded_args+=("build")
        prefer_configuration_cache=1
        ;;
      ci)
        alias_label="ci"
        forwarded_args+=("ci")
        prefer_configuration_cache=1
        ;;
      test)
        alias_label="test"
        forwarded_args+=("test")
        prefer_configuration_cache=1
        ;;
      check)
        alias_label="check"
        forwarded_args+=("check")
        prefer_configuration_cache=1
        ;;
      clean)
        alias_label="clean"
        forwarded_args+=("clean")
        prefer_configuration_cache=1
        ;;
      dist)
        alias_label="dist"
        forwarded_args+=("assembleJvnGamePortableCurrent")
        ;;
      dist-all|distAll|portable-all|portableAll)
        alias_label="dist-all"
        forwarded_args+=("assembleJvnGamePortable")
        ;;
      dist-runtime|distRuntime|portable-runtime|portableRuntime|bundled-runtime|bundledRuntime)
        alias_label="dist-runtime"
        forwarded_args+=("assembleJvnGameBundledRuntimeCurrent")
        ;;
      dist-runtime-all|distRuntimeAll|bundled-runtime-all|bundledRuntimeAll|portable-runtime-all|portableRuntimeAll)
        alias_label="dist-runtime-all"
        forwarded_args+=("assembleJvnGameBundledRuntime")
        ;;
      dist-preflight|distPreflight|preflight|build-plan|buildPlan)
        alias_label="dist-preflight"
        forwarded_args+=("preflightJvnGameBuild")
        ;;
      dist-clean|distClean|clean-dist|cleanDist)
        alias_label="dist-clean"
        forwarded_args+=("cleanJvnGameDistributions")
        ;;
      runtime-cache|runtimeCache)
        alias_label="runtime-cache"
        forwarded_args+=("printJvnBundledRuntimeCache")
        ;;
      runtime-cache-clear|runtimeCacheClear)
        alias_label="runtime-cache-clear"
        forwarded_args+=("clearJvnBundledRuntimeCache")
        ;;
      native|package-native|packageNative)
        alias_label="native"
        forwarded_args+=("packageJvnGameNativeCurrent")
        ;;
      release-native|releaseNative)
        alias_label="release-native"
        forwarded_args+=("releaseJvnGameNativeCurrent")
        ;;
      build-info|buildInfo|doctor)
        alias_label="build-info"
        forwarded_args+=("printJvnBuildEnvironment")
        ;;
      jar)
        alias_label="jar"
        forwarded_args+=(":runtime:jar")
        prefer_configuration_cache=1
        ;;
      gradle)
        alias_label="gradle"
        ;;
      *)
        forwarded_args+=("$arg")
        ;;
    esac
  else
    forwarded_args+=("$arg")
  fi
done

console_specified=0
configuration_cache_specified=0
declare -a task_args=()
if [[ ${#forwarded_args[@]} -gt 0 ]]; then
  for arg in "${forwarded_args[@]}"; do
    case "$arg" in
      --console|--console=*)
        console_specified=1
        ;;
      --configuration-cache|--configuration-cache=*|--no-configuration-cache|-Dorg.gradle.configuration-cache=*|-Dorg.gradle.configuration-cache)
        configuration_cache_specified=1
        ;;
    esac
    if [[ "$arg" != -* ]]; then
      task_args+=("$arg")
    fi
  done
fi

declare -a gradle_cmd=("$GRADLEW_PATH")
if [[ "$console_specified" -eq 0 ]]; then
  gradle_cmd+=("--console=plain")
fi
if [[ "$prefer_configuration_cache" -eq 1 && "$configuration_cache_specified" -eq 0 ]]; then
  gradle_cmd+=("--configuration-cache")
fi
if [[ ${#forwarded_args[@]} -gt 0 ]]; then
  gradle_cmd+=("${forwarded_args[@]}")
fi

spinner_frames=('|' '/' '-' '\')
spinner_index=0
spinner_tick_seconds="0.10"
spinner_tick_marker="__JVNW_SPINNER_TICK__"
status_text="Preparing..."
done_message="Command completed."
compile_started=0
compile_ok_announced=0
launch_announced=0
tests_announced=0
live_failure_output_seen=0
launch_live_announced=0
suppress_status_render=0
command_label=""
resolved_target=""
wrapper_mode="Gradle task"

case "$alias_label" in
  launcher|editor|runtime|compile|quick|build|ci|test|check|clean|dist|dist-all|dist-runtime|dist-runtime-all|dist-preflight|dist-clean|runtime-cache|runtime-cache-clear|native|release-native|build-info|jar)
    command_label="$alias_label"
    ;;
esac

case "$alias_label" in
  launcher|editor|runtime|compile|quick|build|ci|test|check|clean|dist|dist-all|dist-runtime|dist-runtime-all|dist-preflight|dist-clean|runtime-cache|runtime-cache-clear|native|release-native|build-info|jar)
    wrapper_mode="JVN shortcut"
    ;;
  gradle)
    wrapper_mode="Gradle passthrough"
    ;;
esac

case "$alias_label" in
  compile)
    done_message="Compilation OK."
    ;;
  quick)
    done_message="Quick verification OK."
    ;;
  build)
    done_message="Workspace build OK."
    ;;
  ci)
    done_message="CI verification OK."
    ;;
  test)
    done_message="Test suite OK."
    ;;
  check)
    done_message="Checks completed."
    ;;
  clean)
    done_message="Workspace cleaned."
    ;;
  dist)
    done_message="Portable distribution ready."
    ;;
  dist-all)
    done_message="Portable distributions ready."
    ;;
  dist-runtime)
    done_message="Desktop bundle ready."
    ;;
  dist-runtime-all)
    done_message="Desktop bundles ready."
    ;;
  dist-preflight)
    done_message="Game build preflight OK."
    ;;
  dist-clean)
    done_message="Game build artifacts cleaned."
    ;;
  build-info)
    done_message="Build environment printed."
    ;;
  jar)
    done_message="Runtime jar ready."
    ;;
  launcher|editor|runtime)
    done_message="Process exited cleanly."
    ;;
esac

temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/jvnw.XXXXXX")"
fifo_path="$temp_dir/gradle.pipe"
output_log="$temp_dir/gradle.log"
touch "$output_log"
mkfifo "$fifo_path"

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

clear_status() {
  if [[ "$supports_spinner" -eq 1 ]]; then
    printf '\r\033[K'
  fi
}

render_status() {
  if [[ "$supports_spinner" -eq 1 && -n "$status_text" ]]; then
    printf '\r%s %s' "${spinner_frames[$spinner_index]}" "$status_text"
    spinner_index=$(( (spinner_index + 1) % ${#spinner_frames[@]} ))
  fi
}

emit_line() {
  clear_status
  printf '%s\n' "$1"
}

emit_section() {
  emit_line "$(paint "${style_bold}${tone_info}" "$1")"
}

emit_detail() {
  emit_line "  $(paint "${style_bold}${tone_info}" "$1") $(paint "${style_bold}" "$2")"
}

emit_info() {
  emit_line "$(paint "${style_bold}${tone_info}" "[INFO]") $1"
}

emit_ok() {
  emit_line "$(paint "${style_bold}${tone_success}" "[OK]") $1"
}

emit_warn() {
  emit_line "$(paint "${style_bold}${tone_warn}" "[WARN]") $1"
}

emit_error() {
  emit_line "$(paint "${style_bold}${tone_error}" "[FAIL]") $1"
}

emit_hint() {
  emit_line "$(paint "${style_dim}${tone_hint}" "$1")"
}

emit_raw() {
  local line="$1"
  case "$line" in
    FAILURE:*|*"Execution failed for task"*|*"What went wrong:"*|*"Caused by:"*|*"BUILD FAILED"*)
      emit_line "$(paint "$tone_error" "$line")"
      ;;
    WARNING:*|*WARN*)
      emit_line "$(paint "$tone_warn" "$line")"
      ;;
    *)
      emit_line "$line"
      ;;
  esac
}

is_real_error_line() {
  local line="$1"
  [[ "$line" == *"Execution failed for task"* ]] && return 0
  [[ "$line" == *"BUILD FAILED"* ]] && return 0
  [[ "$line" == FAILURE:* ]] && return 0
  [[ "$line" == *" What went wrong:"* ]] && return 0
  [[ "$line" == *"* What went wrong:"* ]] && return 0
  [[ "$line" == *"Caused by:"* ]] && return 0
  [[ "$line" == *"Exception"* ]] && return 0
  [[ "$line" == *": error:"* ]] && return 0
  [[ "$line" == *" error C"* ]] && return 0
  [[ "$line" == *"fatal error:"* ]] && return 0
  return 1
}

should_surface_line() {
  local line="$1"
  if [[ "$debug_mode" == "1" || "$alias_label" == "gradle" ]]; then
    return 0
  fi
  if [[ "$alias_label" == "build-info" ]]; then
    return 0
  fi
  case "$line" in
    "> Task "*)
      ;;
    ">"*)
      return 0
      ;;
    *" FAILED"*)
      return 0
      ;;
  esac
  if is_real_error_line "$line"; then
    return 0
  fi
  return 1
}

show_failure_summary() {
  local elapsed_label="$1"
  if [[ "$debug_mode" == "1" ]]; then
    emit_error "Command failed after ${elapsed_label}."
    return
  fi

  emit_error "Command failed after ${elapsed_label}."
  if [[ "$live_failure_output_seen" -eq 1 ]]; then
    emit_hint "Failure output was already surfaced above."
  else
    emit_section "Relevant output"

    local surfaced=0
    while IFS= read -r line; do
      if should_surface_line "$line"; then
        emit_raw "$line"
        surfaced=1
      fi
    done <"$output_log"

    if [[ "$surfaced" -eq 0 ]]; then
      tail -n 40 "$output_log" | while IFS= read -r line; do
        emit_raw "$line"
      done
    fi
  fi

  emit_hint "Re-run with ./jvnw --raw <same-args> for full Gradle output."
}

handle_line() {
  local line="$1"

  case "$line" in
    Starting\ a\ Gradle\ Daemon*|*busy\ and*Daemons\ could\ not\ be\ reused*)
      status_text="Starting Gradle daemon..."
      ;;
    "> Task "*:compileJava*|"> Task "*:compileKotlin*|"> Task "*:compileScala*)
      if [[ "$compile_started" -eq 0 ]]; then
        emit_info "Compiling modules..."
        compile_started=1
      fi
      status_text="Compiling modules..."
      ;;
    "> Task "*:processResources*|"> Task "*:classes*)
      if [[ "$compile_started" -eq 1 ]]; then
        status_text="Finalizing compiled modules..."
      fi
      ;;
    "> Task :"?*":test"*)
      if [[ "$compile_started" -eq 1 && "$compile_ok_announced" -eq 0 ]]; then
        emit_info "Compilation finished."
        compile_ok_announced=1
      fi
      if [[ "$tests_announced" -eq 0 ]]; then
        emit_info "Running tests..."
        tests_announced=1
      fi
      status_text="Running tests..."
      ;;
    "> Task :editor:runLauncher"*|"> Task :editor:run"*|"> Task :runtime:run"*)
      if [[ "$compile_started" -eq 1 && "$compile_ok_announced" -eq 0 ]]; then
        emit_info "Compilation finished."
        compile_ok_announced=1
      fi
      if [[ "$launch_announced" -eq 0 ]]; then
        emit_info "Launching..."
        launch_announced=1
      fi
      suppress_status_render=0
      launch_live_announced=0
      status_text="Launching..."
      ;;
    WARNING:\ A\ restricted\ method\ in\ java.lang.System\ has\ been\ called*|\
    WARNING:\ java.lang.System::*|\
    WARNING:\ Use\ --enable-native-access=*|\
    WARNING:\ Restricted\ methods\ will\ be\ blocked*|\
    WARNING:\ A\ terminally\ deprecated\ method\ in\ sun.misc.Unsafe\ has\ been\ called*|\
    WARNING:\ sun.misc.Unsafe::*|\
    WARNING:\ Please\ consider\ reporting\ this\ to\ the\ maintainers*)
      ;;
    Note:\ Some\ input\ files\ use\ unchecked\ or\ unsafe\ operations.*|\
    Note:\ Recompile\ with\ -Xlint:unchecked\ for\ details.*)
      ;;
    BUILD\ SUCCESSFUL*)
      if [[ "$done_message" == "Command completed." ]]; then
        done_message="Ready."
      fi
      ;;
    "")
      ;;
    *)
      if should_surface_line "$line"; then
        live_failure_output_seen=1
        emit_raw "$line"
      fi
      ;;
  esac
}

if [[ -z "$command_label" && ${#task_args[@]} -gt 0 ]]; then
  command_label="${task_args[*]}"
fi

if [[ ${#task_args[@]} -gt 0 ]]; then
  resolved_target="$(join_by_space "${task_args[@]}")"
fi

if [[ -n "$command_label" ]]; then
  status_text="Preparing ${command_label}..."
fi

if [[ -n "$command_label" || -n "$resolved_target" ]]; then
  if [[ -n "$command_label" ]]; then
    emit_detail "Command" "$command_label"
  fi
  if [[ -n "$resolved_target" ]]; then
    emit_detail "Target " "$resolved_target"
  fi
  emit_detail "Mode   " "$wrapper_mode"
  printf '\n'
fi

start_time_epoch="$(date +%s)"
if [[ "$supports_spinner" -eq 1 ]]; then
  render_status
fi
"${gradle_cmd[@]}" >"$fifo_path" 2>&1 &
gradle_pid=$!

exec 3< <(
  perl -e '
    use strict;
    use warnings;
    use IO::Select;
    $| = 1;

    my ($interval, $tick_marker, $fifo_path) = @ARGV;
    open my $fh, "<", $fifo_path or die "Unable to open $fifo_path: $!";

    my $selector = IO::Select->new($fh);
    while (1) {
      my @ready = $selector->can_read($interval);
      if (@ready) {
        my $line = <$fh>;
        last unless defined $line;
        $line =~ s/\r?\n\z//;
        print "$line\n";
      } else {
        print "$tick_marker\n";
      }
    }
  ' "$spinner_tick_seconds" "$spinner_tick_marker" "$fifo_path"
)

while IFS= read -r line <&3; do
  if [[ "$line" == "$spinner_tick_marker" ]]; then
    if kill -0 "$gradle_pid" 2>/dev/null; then
      if [[ "$launch_announced" -eq 1 && "$launch_live_announced" -eq 0 ]]; then
        clear_status
        case "$command_label" in
          launcher)
            emit_info "Launcher running. Close the launcher window to finish this command."
            ;;
          editor)
            emit_info "Editor running. Close the editor window to finish this command."
            ;;
          runtime|run|game)
            emit_info "Runtime running. Close the runtime window to finish this command."
            ;;
          *)
            emit_info "Application process is running."
            ;;
        esac
        launch_live_announced=1
        suppress_status_render=1
      fi
      if [[ "$suppress_status_render" -eq 0 ]]; then
        render_status
      fi
    fi
  else
    printf '%s\n' "$line" >>"$output_log"
    handle_line "$line"
  fi
done

wait "$gradle_pid"
exit_code=$?
elapsed_seconds=$(( $(date +%s) - start_time_epoch ))
elapsed_label="$(format_duration "$elapsed_seconds")"

clear_status

if [[ "$exit_code" -eq 0 ]]; then
  emit_ok "${done_message} ${elapsed_label}"
else
  show_failure_summary "$elapsed_label"
fi

exit "$exit_code"
