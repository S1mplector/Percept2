#!/usr/bin/env bash

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
GRADLEW_PATH="$SCRIPT_DIR/gradlew"

if [[ ! -f "$GRADLEW_PATH" ]]; then
  printf 'JVN wrapper error: missing %s\n' "$GRADLEW_PATH" >&2
  exit 1
fi

raw_mode="${JVN_WRAPPER_RAW:-0}"
debug_mode="${JVN_WRAPPER_DEBUG:-0}"
supports_spinner=0

if [[ -t 1 && "${TERM:-}" != "dumb" && -z "${CI:-}" ]]; then
  supports_spinner=1
fi

show_help() {
  printf 'JVN wrapper\n\n'
  printf 'Use ./jvnw for day-to-day work. It maps plain commands onto the right Gradle tasks.\n\n'
  printf 'Common commands:\n'
  printf '  ./jvnw launcher    Run the standalone launcher\n'
  printf '  ./jvnw editor      Run the editor\n'
  printf '  ./jvnw runtime     Run the runtime\n'
  printf '  ./jvnw build       Build the workspace\n'
  printf '  ./jvnw test        Run the test suite\n'
  printf '  ./jvnw dist        Create the runtime distribution zip\n'
  printf '  ./jvnw jar         Build the runtime jar\n'
  printf '\n'
  printf 'Advanced usage:\n'
  printf '  ./jvnw gradle <gradle-args>    Pass straight through to Gradle with JVN console styling\n'
  printf '  ./jvnw --raw <gradle-args>     Bypass JVN styling and call ./gradlew directly\n'
  printf '  ./gradlew <gradle-task>        Optional low-level Gradle entrypoint\n'
}

declare -a input_args=()
if [[ $# -gt 0 ]]; then
  for arg in "$@"; do
    if [[ "$arg" == "--raw" ]]; then
      raw_mode=1
    else
      input_args+=("$arg")
    fi
  done
fi

if [[ "$raw_mode" == "1" ]]; then
  if [[ ${#input_args[@]} -gt 0 ]]; then
    exec "$GRADLEW_PATH" "${input_args[@]}"
  fi
  exec "$GRADLEW_PATH"
fi

if [[ ${#input_args[@]} -eq 0 ]]; then
  show_help
  exit 0
fi

declare -a forwarded_args=()
alias_label=""
first_non_option_seen=0

for arg in "${input_args[@]}"; do
  if [[ "$first_non_option_seen" -eq 0 && "$arg" != -* ]]; then
    first_non_option_seen=1
    case "$arg" in
      help|-h|--help)
        show_help
        exit 0
        ;;
      launcher)
        alias_label="launcher"
        forwarded_args+=(":editor:runLauncher")
        ;;
      editor)
        alias_label="editor"
        forwarded_args+=(":editor:run")
        ;;
      runtime|run|game)
        alias_label="runtime"
        forwarded_args+=(":runtime:run")
        ;;
      build)
        alias_label="build"
        forwarded_args+=("build")
        ;;
      test)
        alias_label="test"
        forwarded_args+=("test")
        ;;
      check)
        alias_label="check"
        forwarded_args+=("check")
        ;;
      clean)
        alias_label="clean"
        forwarded_args+=("clean")
        ;;
      dist)
        alias_label="dist"
        forwarded_args+=(":runtime:distZip")
        ;;
      jar)
        alias_label="jar"
        forwarded_args+=(":runtime:jar")
        ;;
      gradle)
        alias_label="gradle"
        ;;
      *)
        forwarded_args+=("$arg")
        ;;
    esac
  else
    forwarded_args+=("$arg")
  fi
done

console_specified=0
declare -a task_args=()
if [[ ${#forwarded_args[@]} -gt 0 ]]; then
  for arg in "${forwarded_args[@]}"; do
    case "$arg" in
      --console|--console=*)
        console_specified=1
        ;;
    esac
    if [[ "$arg" != -* ]]; then
      task_args+=("$arg")
    fi
  done
fi

declare -a gradle_cmd=("$GRADLEW_PATH")
if [[ "$console_specified" -eq 0 ]]; then
  gradle_cmd+=("--console=plain")
fi
if [[ ${#forwarded_args[@]} -gt 0 ]]; then
  gradle_cmd+=("${forwarded_args[@]}")
fi

spinner_frames=('|' '/' '-' '\')
spinner_index=0
status_text="Preparing Gradle wrapper..."
done_message="Ready."
compile_started=0
compile_ok_announced=0
launch_announced=0
native_math_announced=0
audiofx_announced=0
command_label=""

case "$alias_label" in
  launcher|editor|runtime|build|test|check|clean|dist|jar)
    command_label="$alias_label"
    ;;
esac

temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/jvnw.XXXXXX")"
fifo_path="$temp_dir/gradle.pipe"
output_log="$temp_dir/gradle.log"
touch "$output_log"
mkfifo "$fifo_path"

cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

clear_status() {
  if [[ "$supports_spinner" -eq 1 ]]; then
    printf '\r\033[K'
  fi
}

render_status() {
  if [[ "$supports_spinner" -eq 1 && -n "$status_text" ]]; then
    printf '\r%s %s' "${spinner_frames[$spinner_index]}" "$status_text"
    spinner_index=$(( (spinner_index + 1) % ${#spinner_frames[@]} ))
  fi
}

emit_line() {
  clear_status
  printf '%s\n' "$1"
}

emit_info() {
  emit_line "$1"
}

emit_raw() {
  emit_line "$1"
}

should_surface_line() {
  local line="$1"
  if [[ "$debug_mode" == "1" ]]; then
    return 0
  fi
  case "$line" in
    FAILURE:*|\
    *"Execution failed for task"*|\
    *"What went wrong:"*|\
    *"Caused by:"*|\
    *"Exception"*|\
    *"error:"*|\
    *" FAILED"*|\
    *"BUILD FAILED"*)
      return 0
      ;;
  esac
  return 1
}

show_failure_summary() {
  if [[ "$debug_mode" == "1" ]]; then
    emit_info "Build failed."
    return
  fi

  emit_info "Build failed."
  emit_info "Relevant output:"

  local surfaced=0
  while IFS= read -r line; do
    if should_surface_line "$line"; then
      emit_raw "$line"
      surfaced=1
    fi
  done <"$output_log"

  if [[ "$surfaced" -eq 0 ]]; then
    tail -n 40 "$output_log" | while IFS= read -r line; do
      emit_raw "$line"
    done
  fi

  emit_info "Re-run with ./jvnw --raw <same-args> for full Gradle output."
}

handle_line() {
  local line="$1"

  case "$line" in
    native-math\ already\ built:*)
      if [[ "$native_math_announced" -eq 0 ]]; then
        emit_info "Native math bridge OK"
        native_math_announced=1
      fi
      ;;
    "> Task :buildNativeMathIfNeeded"*)
      status_text="Checking native math bridge..."
      ;;
    "> Task :audio-fx:buildAudioFxNativeIfNeeded"*)
      status_text="Building AudioFX native bridge..."
      ;;
    --\ Configuring\ done*|--\ Generating\ done*|--\ Build\ files\ have\ been\ written\ to:*)
      ;;
    \[*Building\ C\ object*|\[*Building\ CXX\ object*)
      status_text="Compiling native audio modules..."
      ;;
    \[*Linking\ CXX\ shared\ library\ libjvn_audiofx_native.dylib*)
      status_text="Linking native audio modules..."
      ;;
    \[*Built\ target\ jvn_audiofx_native*)
      if [[ "$audiofx_announced" -eq 0 ]]; then
        emit_info "AudioFX native bridge OK"
        audiofx_announced=1
      fi
      ;;
    Starting\ a\ Gradle\ Daemon*|*busy\ and*Daemons\ could\ not\ be\ reused*)
      status_text="Starting Gradle daemon..."
      ;;
    "> Task "*:compileJava*|"> Task "*:compileKotlin*|"> Task "*:compileScala*)
      if [[ "$compile_started" -eq 0 ]]; then
        emit_info "Compiling submodules..."
        compile_started=1
      fi
      status_text="Compiling submodules..."
      ;;
    "> Task "*:processResources*|"> Task "*:classes*)
      if [[ "$compile_started" -eq 1 ]]; then
        status_text="Finalizing compiled modules..."
      fi
      ;;
    "> Task "*:runLauncher*|"> Task "*:run*)
      if [[ "$compile_started" -eq 1 && "$compile_ok_announced" -eq 0 ]]; then
        emit_info "Compiling submodules OK"
        compile_ok_announced=1
      fi
      if [[ "$launch_announced" -eq 0 ]]; then
        emit_info "Launching..."
        launch_announced=1
      fi
      status_text="Launching..."
      ;;
    WARNING:\ A\ restricted\ method\ in\ java.lang.System\ has\ been\ called*|\
    WARNING:\ java.lang.System::*|\
    WARNING:\ Use\ --enable-native-access=*|\
    WARNING:\ Restricted\ methods\ will\ be\ blocked*|\
    WARNING:\ A\ terminally\ deprecated\ method\ in\ sun.misc.Unsafe\ has\ been\ called*|\
    WARNING:\ sun.misc.Unsafe::*|\
    WARNING:\ Please\ consider\ reporting\ this\ to\ the\ maintainers*)
      ;;
    Note:\ Some\ input\ files\ use\ unchecked\ or\ unsafe\ operations.*|\
    Note:\ Recompile\ with\ -Xlint:unchecked\ for\ details.*)
      ;;
    BUILD\ SUCCESSFUL*)
      done_message="Ready."
      ;;
    BUILD\ FAILED*)
      done_message="Build failed."
      ;;
    "")
      ;;
    *)
      if should_surface_line "$line"; then
        emit_raw "$line"
      fi
      ;;
  esac
}

if [[ -z "$command_label" && ${#task_args[@]} -gt 0 ]]; then
  command_label="${task_args[*]}"
fi

if [[ -n "$command_label" ]]; then
  status_text="Preparing ${command_label}..."
fi

printf 'Welcome to JVN.\n'
printf 'Thanks for choosing our engine to build with.\n\n'

"${gradle_cmd[@]}" >"$fifo_path" 2>&1 &
gradle_pid=$!

exec 3<"$fifo_path"

while true; do
  if IFS= read -r -t 1 line <&3; then
    printf '%s\n' "$line" >>"$output_log"
    handle_line "$line"
  else
    if kill -0 "$gradle_pid" 2>/dev/null; then
      render_status
    else
      while IFS= read -r line <&3; do
        printf '%s\n' "$line" >>"$output_log"
        handle_line "$line"
      done
      break
    fi
  fi
done

wait "$gradle_pid"
exit_code=$?

clear_status

if [[ "$exit_code" -eq 0 ]]; then
  emit_info "$done_message"
else
  show_failure_summary
fi

exit "$exit_code"
